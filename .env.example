# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# LDAP Configuration
AUTH_LDAP_SERVER_URI=ldap://your-domain-controller.company.com
AUTH_LDAP_BIND_DN=cn=bind-user,ou=service-accounts,dc=company,dc=com
AUTH_LDAP_BIND_PASSWORD=bind-password
AUTH_LDAP_BASE_DN=ou=users,dc=company,dc=com

# SharePoint Graph API Configuration
CLIENT_ID=your-sharepoint-client-id
CLIENT_SECRET=your-sharepoint-client-secret
TENANT_ID=your-azure-tenant-id

# Database (if needed)
DATABASE_URL=sqlite:///db.sqlite3
